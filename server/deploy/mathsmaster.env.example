# /etc/mathsmaster/mathsmaster.env  (chmod 600, owned by root or mathsmaster)
# Never commit the real file: it may hold CLAUDE_CODE_OAUTH_TOKEN.

MM_DATA_DIR=/var/lib/mathsmaster
MM_HOST=127.0.0.1
MM_PORT=8787

# Claude Code
MM_CLAUDE_MODEL=claude-opus-5-5
MM_CLAUDE_EFFORT_JOBS=high
#MM_CLAUDE_EFFORT_THREADS=
#MM_CLAUDE_BIN=/home/mathsmaster/.local/bin/claude
#MM_CLAUDE_TOOLS=Read,Glob,Grep,Write,Edit
#MM_CLAUDE_EXTRA_ARGS=--max-turns 200
#MM_JOB_CONCURRENCY=1
#MM_THREAD_CONCURRENCY=2
#MM_JOB_TIMEOUT_S=21600
#MM_THREAD_TIMEOUT_S=1800
#MM_FIX_ROUNDS=2

# Option B for the Claude login (instead of signing in interactively as the
# mathsmaster user): a long-lived token from `claude setup-token`.
#CLAUDE_CODE_OAUTH_TOKEN=

# Limits
#MM_MAX_UPLOAD_MB=1024
#MM_TRASH_DAYS=30

# Demo mode without Claude (canned replies):
#MM_CLAUDE_RUNNER=fake
