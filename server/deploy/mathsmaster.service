# /etc/systemd/system/mathsmaster.service
# MathsMaster companion service. See server/README.md for the full deploy guide.
[Unit]
Description=MathsMaster VPS service (backup mirror, Anki import, Claude jobs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mathsmaster
Group=mathsmaster
WorkingDirectory=/opt/mathsmaster
EnvironmentFile=/etc/mathsmaster/mathsmaster.env
# Claude Code's native installer puts `claude` in ~/.local/bin of the service user.
Environment=PATH=/home/mathsmaster/.local/bin:/opt/mathsmaster/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/mathsmaster/venv/bin/mathsmaster-server serve
Restart=on-failure
RestartSec=5
# Give running Claude jobs a moment to be marked for re-queue on stop.
TimeoutStopSec=30

# Hardening. The service only writes its data dir and the user's home (Claude Code
# keeps its login and sessions in ~/.claude).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/mathsmaster /home/mathsmaster
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
